  <diagram id="slide_2" name="2. Parsing, Validation &amp; Filter">
    <mxGraphModel dx="1420" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1360" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="slide_2_title" value="&lt;b&gt;PTS Hub — Detailed Process Flow (2/4): Run Gate, Parallel STDF Parsing &amp;amp; Coordinate Filtering&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1E3A5F;fontColor=#FFFFFF;strokeColor=none;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="28" y="14" width="1224" height="52" as="geometry" />
        </mxCell>
        <mxCell id="slide_2_lane_1" value="2A. Run Gate &amp;amp; Cache Check" style="swimlane;startSize=34;rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#1D4ED8;strokeColor=#93C5FD;swimlaneFillColor=#EFF6FF;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="28" y="82" width="286" height="614" as="geometry" />
        </mxCell>
        <mxCell id="slide_2_lane_2" value="2B. Parallel Parse Strategy" style="swimlane;startSize=34;rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#0F766E;strokeColor=#5EEAD4;swimlaneFillColor=#F0FDFA;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="340" y="82" width="286" height="614" as="geometry" />
        </mxCell>
        <mxCell id="slide_2_lane_3" value="2C. Binary STDF V4 Scanner" style="swimlane;startSize=34;rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#4338CA;strokeColor=#A5B4FC;swimlaneFillColor=#EEF2FF;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="652" y="82" width="286" height="614" as="geometry" />
        </mxCell>
        <mxCell id="slide_2_lane_4" value="2D. WXY &amp;amp; Multi-ID Filtering" style="swimlane;startSize=34;rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#B45309;strokeColor=#FCD34D;swimlaneFillColor=#FFFBEB;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="964" y="82" width="286" height="614" as="geometry" />
        </mxCell>
        <mxCell id="s2_1" value="&lt;b&gt;Click Run Analysis (start_get_data)&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9.5px'&gt;Uppercase Lot ID &amp;amp; MPC; snapshot current lot details to Activity Log.&lt;/font&gt;" style="rounded=1;arcSize=26;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D4ED8;strokeWidth=2;fontColor=#1E293B;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="48" y="144" width="247" height="97" as="geometry" />
        </mxCell>
        <mxCell id="s2_2" value="&lt;b&gt;Inputs Valid?&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9.5px'&gt;Panels, Int QTYs, 12-char MPC&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#D97706;strokeWidth=2;fontColor=#9A3412;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="49" y="266" width="243" height="92" as="geometry" />
        </mxCell>
        <mxCell id="s2_3" value="&lt;b&gt;Show Validation Error &amp;amp; Abort&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9.5px'&gt;Block missing panels, non-integer QTY, bad MPC, or unmapped mask without 3 Manual Filter tests.&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#991B1B;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="59" y="385" width="224" height="82" as="geometry" />
        </mxCell>
        <mxCell id="s2_4" value="&lt;b&gt;Session Cache Hit?&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9.5px'&gt;(_analysis_cache: inputs + file mtime)&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#D97706;strokeWidth=2;fontColor=#9A3412;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="46" y="493" width="251" height="90" as="geometry" />
        </mxCell>
        <mxCell id="s2_5" value="&lt;b&gt;Cache Hit -&amp;gt; Skip Parsing&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9.5px'&gt;Jump directly to Slide 4 (_deliver_analysis_result).&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.5;fontColor=#1E293B;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="48" y="606" width="247" height="69" as="geometry" />
        </mxCell>
        <mxCell id="s2_6" value="&lt;b&gt;Resolve Test Numbers &amp;amp; Sort&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9.5px'&gt;Lookup 5-char mask in mask_wxy_map.json (or 3 Manual Filter tests); sort files in each panel by first YYYYMMDDHHMMSS.&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=1.5;fontColor=#1E293B;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="360" y="144" width="247" height="109" as="geometry" />
        </mxCell>
        <mxCell id="s2_7" value="&lt;b&gt;Cross-Panel Unique File Pool&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9.5px'&gt;Pool unique paths from FP + RETEST + QC; select largest file for main thread &amp;amp; remaining smaller files for ProcessPoolExecutor.&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=1.5;fontColor=#1E293B;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="360" y="282" width="247" height="119" as="geometry" />
        </mxCell>
        <mxCell id="s2_8" value="&lt;b&gt;Open Binary STDF Reader&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9.5px'&gt;Local uncompressed file -&amp;gt; zero-copy mmap.ACCESS_READ; .gz or remote UNC file -&amp;gt; transparent stream/stage copy.&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=1.5;fontColor=#1E293B;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="360" y="430" width="247" height="119" as="geometry" />
        </mxCell>
        <mxCell id="s2_9" value="&lt;b&gt;Collect Parsed Panel Dictionaries&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9.5px'&gt;Update live progress bar (15% -&amp;gt; 92% bytes); assemble row records sequentially by sorted timestamp order.&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=1.5;fontColor=#1E293B;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="360" y="577" width="247" height="92" as="geometry" />
        </mxCell>
        <mxCell id="s2_10" value="&lt;b&gt;1. FAR (0,10) &amp;amp; MIR (1,10)&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9.5px'&gt;Verify FAR at offset 0 (STDF_VER=4, REC_LEN=2, endian &amp;lt; or &amp;gt;); verify MIR.LOT_ID matches input Lot ID (strip .RJ&amp;lt;N&amp;gt;).&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4338CA;strokeWidth=1.5;fontColor=#1E293B;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="672" y="144" width="247" height="103" as="geometry" />
        </mxCell>
        <mxCell id="s2_11" value="&lt;b&gt;2. PIR -&amp;gt; PTR (Fast) -&amp;gt; PRR Loop&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9.5px'&gt;Track site slot (HEAD&amp;lt;&amp;lt;8)|SITE; PTR peeks 4B TEST_NUM (skips non-filter PTRs); PRR checks PART_FLG&amp;amp;0x08 PASS/FAIL &amp;amp; bins.&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4338CA;strokeWidth=1.5;fontColor=#1E293B;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="672" y="274" width="247" height="117" as="geometry" />
        </mxCell>
        <mxCell id="s2_12" value="&lt;b&gt;3. PCR/HBR/SBR &amp;amp; MRR (1,20)&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9.5px'&gt;Reconcile PCR/HBR/SBR vs PRR counts; drop orphan PIRs without PRR; require MRR end == file_size (no trailing bytes).&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4338CA;strokeWidth=1.5;fontColor=#1E293B;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="672" y="418" width="247" height="103" as="geometry" />
        </mxCell>
        <mxCell id="s2_13" value="&lt;b&gt;Strict Validation OK?&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9.5px'&gt;FAR, MIR, EOF, &amp;gt;0 PRRs&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#D97706;strokeWidth=2;fontColor=#9A3412;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="672" y="543" width="247" height="88" as="geometry" />
        </mxCell>
        <mxCell id="s2_14" value="&lt;b&gt;Block Analysis (Log File &amp;amp; Byte Offset)&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#991B1B;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="672" y="645" width="247" height="42" as="geometry" />
        </mxCell>
        <mxCell id="s2_15" value="&lt;b&gt;Normalize Unset &amp;amp; Format WXY&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9.5px'&gt;Normalize 65535 bins &amp;amp; TEST_T==0; format Wafer/X/Y floats (round to int or NaN); join &amp;quot;{Wafer}_{X}_{Y}&amp;quot;.&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B45309;strokeWidth=1.5;fontColor=#1E293B;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="984" y="144" width="247" height="101" as="geometry" />
        </mxCell>
        <mxCell id="s2_16" value="&lt;b&gt;WXY Validity Rule (_is_valid_wxy)&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9.5px'&gt;INVALID if empty, &amp;#x27;NaN&amp;#x27; in val, Wafer == 0 regardless of X &amp;amp; Y (0_1_2, 0_137_136), or &amp;gt;=2 zero parts (0_0_0, 24_0_0). Valid: W!=0 &amp;amp; &amp;lt;=1 zero.&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B45309;strokeWidth=1.5;fontColor=#1E293B;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="984" y="272" width="247" height="132" as="geometry" />
        </mxCell>
        <mxCell id="s2_17" value="&lt;b&gt;Multi-ID Mask?&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9.5px'&gt;(e.g. SG406 / UID+MACID)&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#D97706;strokeWidth=2;fontColor=#9A3412;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="982" y="432" width="251" height="92" as="geometry" />
        </mxCell>
        <mxCell id="s2_18" value="&lt;b&gt;Multi-ID Extract -&amp;gt; Slide 3&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9.5px'&gt;Yes: also extract UID (!=NaN) &amp;amp; BT/ZB MACIDs (prefix-checked: 64_132 / 40:84). Both Yes &amp;amp; No proceed to Slide 3.&lt;/font&gt;" style="rounded=1;arcSize=26;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B45309;strokeWidth=2;fontColor=#1E293B;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="984" y="552" width="247" height="119" as="geometry" />
        </mxCell>
