  <diagram id="slide_1" name="1. UI, MES &amp; STDF Acquisition">
    <mxGraphModel dx="1420" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1360" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="slide_1_title" value="&lt;b&gt;PTS Hub — Detailed Process Flow (1/4): Startup, MES Lookup, Get STDF &amp;amp; Check STDF&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1E3A5F;fontColor=#FFFFFF;strokeColor=none;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="28" y="14" width="1224" height="52" as="geometry" />
        </mxCell>
        <mxCell id="slide_1_lane_1" value="1A. Startup &amp;amp; User Inputs" style="swimlane;startSize=34;rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#1D4ED8;strokeColor=#93C5FD;swimlaneFillColor=#EFF6FF;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="28" y="82" width="286" height="614" as="geometry" />
        </mxCell>
        <mxCell id="slide_1_lane_2" value="1B. MES, Device Config &amp;amp; Fails" style="swimlane;startSize=34;rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#4338CA;strokeColor=#A5B4FC;swimlaneFillColor=#EEF2FF;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="340" y="82" width="286" height="614" as="geometry" />
        </mxCell>
        <mxCell id="slide_1_lane_3" value="1C. Get STDF (Network Fetch)" style="swimlane;startSize=34;rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#0F766E;strokeColor=#5EEAD4;swimlaneFillColor=#F0FDFA;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="652" y="82" width="286" height="614" as="geometry" />
        </mxCell>
        <mxCell id="slide_1_lane_4" value="1D. Check STDF Integrity Scan" style="swimlane;startSize=34;rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#15803D;strokeColor=#86EFAC;swimlaneFillColor=#F0FDF4;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="964" y="82" width="286" height="614" as="geometry" />
        </mxCell>
        <mxCell id="s1_1" value="&lt;b&gt;Launch PTS_Hub.exe / main.py&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9.5px'&gt;Run freeze_support(), set AppUserModelID, resolve external assets/ via get_app_root(), pre-warm HTTP &amp;amp; Device caches.&lt;/font&gt;" style="rounded=1;arcSize=26;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D4ED8;strokeWidth=2;fontColor=#1E293B;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="48" y="144" width="247" height="107" as="geometry" />
        </mxCell>
        <mxCell id="s1_2" value="&lt;b&gt;Open FTDC Checker Tab&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9.5px'&gt;Load settings.json URLs/paths; user enters Lot ID, FP Actual Good QTY &amp;amp; Total Actual Good QTY (+ optional Manual Test Filter).&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D4ED8;strokeWidth=1.5;fontColor=#1E293B;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="48" y="278" width="247" height="113" as="geometry" />
        </mxCell>
        <mxCell id="s1_3" value="&lt;b&gt;Panel File Acquisition Path&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9.5px'&gt;Select FIRST PASS, RETEST &amp;amp; QC files: either auto-fetch via Get STDF or manually browse/drop local STDF files.&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D4ED8;strokeWidth=1.5;fontColor=#1E293B;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="48" y="418" width="247" height="111" as="geometry" />
        </mxCell>
        <mxCell id="s1_4" value="&lt;b&gt;Optional: Manual Filter Setup&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9.5px'&gt;Choose PTR tests by number/range or scan_test_list() if mask is not in mask_wxy_map.json (requires 3 WXY tests).&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D4ED8;strokeWidth=1.5;fontColor=#1E293B;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="48" y="556" width="247" height="105" as="geometry" />
        </mxCell>
        <mxCell id="s1_5" value="&lt;b&gt;Complete Lot ID?&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9.5px'&gt;(auto MES lookup)&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#D97706;strokeWidth=2;fontColor=#9A3412;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="358" y="142" width="251" height="92" as="geometry" />
        </mxCell>
        <mxCell id="s1_6" value="&lt;b&gt;MES SOAP Lookup (Background)&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9.5px'&gt;POST GetLotByLotId to mes_url; auto-fill 12-char MPC code &amp;amp; trigger background FTDC Fail prefetch.&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4338CA;strokeWidth=1.5;fontColor=#1E293B;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="360" y="261" width="247" height="113" as="geometry" />
        </mxCell>
        <mxCell id="s1_7" value="&lt;b&gt;Device Settings Manager (Config)&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9.5px'&gt;View/Add/Edit/Delete MPCs, tester paths, filename conventions &amp;amp; WXY/Multi-ID tests; updates JSONs in assets/ &amp;amp; reloads caches.&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.5;fontColor=#1E293B;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="360" y="401" width="247" height="119" as="geometry" />
        </mxCell>
        <mxCell id="s1_8" value="&lt;b&gt;Get FTDC Fail (Optional)&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9.5px'&gt;Query ftdc/filter.php (primary URL -&amp;gt; backup fallback); parse HTML fail table &amp;amp; display Reply/Comment/Tester popup.&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4338CA;strokeWidth=1.5;fontColor=#1E293B;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="360" y="547" width="247" height="115" as="geometry" />
        </mxCell>
        <mxCell id="s1_9" value="&lt;b&gt;Start Get STDF: Resolve MPC &amp;amp; Mask&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9.5px'&gt;Lookup 12-char MPC in mpc_partnumber.json &amp;amp; 5-char mask convention in stdf_filename_conventions.json.&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=1.5;fontColor=#1E293B;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="672" y="144" width="247" height="101" as="geometry" />
        </mxCell>
        <mxCell id="s1_10" value="&lt;b&gt;SMB Pushdown Directory Scan&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9.5px'&gt;Scan tester_paths + common_paths via FindFirstFileExW pushdown; prompt user if multiple testers/folders match.&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=1.5;fontColor=#1E293B;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="672" y="272" width="247" height="111" as="geometry" />
        </mxCell>
        <mxCell id="s1_11" value="&lt;b&gt;Copy to C:\FTDC\&amp;lt;Lot&amp;gt; + Stream Cache&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9.5px'&gt;CopyFileExW via .part -&amp;gt; atomic rename (live bar, MB/s, ETA); 2-worker pool pre-warms Check Cache after each file finishes.&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=1.5;fontColor=#1E293B;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="672" y="410" width="247" height="120" as="geometry" />
        </mxCell>
        <mxCell id="s1_12" value="&lt;b&gt;Finish Pre-Warm &amp;amp; Open Folder&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9.5px'&gt;4-worker pool completes remaining files, flushes cache/check_stdf_cache.json once &amp;amp; opens C:\FTDC\&amp;lt;Lot&amp;gt;.&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=1.5;fontColor=#1E293B;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="672" y="558" width="247" height="103" as="geometry" />
        </mxCell>
        <mxCell id="s1_13" value="&lt;b&gt;Start Check STDF: Discover Files&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9.5px'&gt;Scan C:\FTDC\&amp;lt;Lot&amp;gt; (or selected files); build signature (abs_path, size, mtime_ns) for each STDF.&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#15803D;strokeWidth=1.5;fontColor=#1E293B;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="984" y="144" width="247" height="99" as="geometry" />
        </mxCell>
        <mxCell id="s1_14" value="&lt;b&gt;Check Cache Hit?&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9.5px'&gt;(memory / disk JSON)&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#D97706;strokeWidth=2;fontColor=#9A3412;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="986" y="270" width="241" height="90" as="geometry" />
        </mxCell>
        <mxCell id="s1_15" value="&lt;b&gt;C-Fast PRR Tail / Full Scan&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9.5px'&gt;Validate FAR/MIR/MRR, count PRR PASS/FAIL, check MIR.LOT_ID mismatch, extra trailing bytes &amp;amp; Test Time == 0 via ThreadPoolExecutor.&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#15803D;strokeWidth=1.5;fontColor=#1E293B;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="994" y="387" width="226" height="126" as="geometry" />
        </mxCell>
        <mxCell id="s1_16" value="&lt;b&gt;Check Table -&amp;gt; Click Run Analysis&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9.5px'&gt;Show PASS/FAIL &amp;amp; Discrepancy status; 1-click Load to Panel or Delete STDF -&amp;gt; Next: Slide 2 (Run Analysis Gate).&lt;/font&gt;" style="rounded=1;arcSize=26;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#15803D;strokeWidth=2;fontColor=#1E293B;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="983" y="543" width="249" height="119" as="geometry" />
        </mxCell>
