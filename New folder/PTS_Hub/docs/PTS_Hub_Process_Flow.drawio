        <mxCell id="slide_4_title" value="&lt;b&gt;PTS Hub — Detailed Process Flow (4/4): Result Popup, Stage 1 Excel/PNG, Stage 2 PPO &amp;amp; Cleanup&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1E3A5F;fontColor=#FFFFFF;strokeColor=none;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="28" y="14" width="1224" height="52" as="geometry" />
        </mxCell>
        <mxCell id="slide_4_lane_1" value="4A. Result Popup &amp;amp; Download" style="swimlane;startSize=34;rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#1D4ED8;strokeColor=#93C5FD;swimlaneFillColor=#EFF6FF;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="28" y="82" width="286" height="614" as="geometry" />
        </mxCell>
        <mxCell id="slide_4_lane_2" value="4B. Stage 1: Excel &amp;amp; PNG (ETA)" style="swimlane;startSize=34;rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#0F766E;strokeColor=#5EEAD4;swimlaneFillColor=#F0FDFA;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="340" y="82" width="286" height="614" as="geometry" />
        </mxCell>
        <mxCell id="slide_4_lane_3" value="4C. Stage 2: PPO Auto-Attach" style="swimlane;startSize=34;rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#B45309;strokeColor=#FCD34D;swimlaneFillColor=#FFFBEB;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="652" y="82" width="286" height="614" as="geometry" />
        </mxCell>
        <mxCell id="slide_4_lane_4" value="4D. Fallback, Tools &amp;amp; Cleanup" style="swimlane;startSize=34;rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#15803D;strokeColor=#86EFAC;swimlaneFillColor=#F0FDF4;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="964" y="82" width="286" height="614" as="geometry" />
        </mxCell>
        <mxCell id="s4_1" value="&lt;b&gt;Deliver Analysis Result&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9.5px'&gt;Store in _analysis_cache, cache build_summary_and_details(result), log Detailed Report &amp;amp; FTDC Server Fails.&lt;/font&gt;" style="rounded=1;arcSize=26;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D4ED8;strokeWidth=2;fontColor=#1E293B;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="48" y="144" width="247" height="105" as="geometry" />
        </mxCell>
        <mxCell id="s4_2" value="&lt;b&gt;Open FTDC Result Popup Window&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9.5px'&gt;Display Lot Info, PASS/FAIL badges, FP vs Total tables, Multi-ID counts, Remarks, Show Details &amp;amp; Download Excel button.&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D4ED8;strokeWidth=1.5;fontColor=#1E293B;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="48" y="276" width="247" height="113" as="geometry" />
        </mxCell>
        <mxCell id="s4_3" value="&lt;b&gt;Click Download Excel?&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9.5px'&gt;(Stage 1 Done?)&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#D97706;strokeWidth=2;fontColor=#9A3412;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="46" y="416" width="251" height="90" as="geometry" />
        </mxCell>
        <mxCell id="s4_4" value="&lt;b&gt;Race-Safe Excel Open Behavior&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9.5px'&gt;Stage 1 ongoing -&amp;gt; Show &amp;#x27;Excel generation still ongoing&amp;#x27; popup.&#10;Stage 1 ready -&amp;gt; Save &amp;amp; open .xlsx immediately (even during Stage 2!).&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D4ED8;strokeWidth=1.5;fontColor=#1E293B;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="48" y="533" width="247" height="126" as="geometry" />
        </mxCell>
        <mxCell id="s4_5" value="&lt;b&gt;Trigger Stage 1 Background Thread&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9.5px'&gt;Reset progress bar 0-&amp;gt;100%, set status &amp;#x27;Auto-attach to PPO: On-going (generating Excel)...&amp;#x27; &amp;amp; live ETA.&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=1.5;fontColor=#1E293B;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="360" y="144" width="247" height="101" as="geometry" />
        </mxCell>
        <mxCell id="s4_6" value="&lt;b&gt;Write Multi-Sheet .xlsx (xlsxwriter)&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9.5px'&gt;Disable URL regex scan (strings_to_urls=False); write Summary, FT Total, QC Total, Dup GUID FP, QC FAIL (+ Multi-ID sheets).&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=1.5;fontColor=#1E293B;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="360" y="272" width="247" height="128" as="geometry" />
        </mxCell>
        <mxCell id="s4_7" value="&lt;b&gt;Pre-Stage Result Snapshot (.png)&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9.5px'&gt;Render crisp table/badge PNG (result_image.py) into temp staging alongside .xlsx.&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=1.5;fontColor=#1E293B;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="360" y="428" width="247" height="107" as="geometry" />
        </mxCell>
        <mxCell id="s4_8" value="&lt;b&gt;Mark Stage 1 READY&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9.5px'&gt;Set _excel_ready_event &amp;amp; _excel_state=&amp;#x27;READY&amp;#x27;; unlock instant Download &amp;amp; Open Excel.&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=1.5;fontColor=#1E293B;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="360" y="562" width="247" height="101" as="geometry" />
        </mxCell>
        <mxCell id="s4_9" value="&lt;b&gt;Already Attached?&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9.5px'&gt;(Cache-Hit Check)&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#D97706;strokeWidth=2;fontColor=#9A3412;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="670" y="142" width="251" height="90" as="geometry" />
        </mxCell>
        <mxCell id="s4_10" value="&lt;b&gt;Scan PPO Subfolders (~15ms)&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9.5px'&gt;Scan \\chip\PPOonline\&amp;lt;Lot&amp;gt; using _pushdown_scandir; lock exact target count N = 2 x subfolders (Done 0/N).&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B45309;strokeWidth=1.5;fontColor=#1E293B;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="672" y="259" width="247" height="105" as="geometry" />
        </mxCell>
        <mxCell id="s4_11" value="&lt;b&gt;Parallel Atomic Copy to PPO&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9.5px'&gt;CopyFileExW .xlsx &amp;amp; .png via .part -&amp;gt; rename to every subfolder; show live Done X/N | MB/s | ETA.&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B45309;strokeWidth=1.5;fontColor=#1E293B;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="672" y="391" width="247" height="119" as="geometry" />
        </mxCell>
        <mxCell id="s4_12" value="&lt;b&gt;Attach Succeeded?&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9.5px'&gt;(&amp;lt;= 3 Attempts; 3s, 8s)&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#D97706;strokeWidth=2;fontColor=#9A3412;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="670" y="539" width="251" height="96" as="geometry" />
        </mxCell>
        <mxCell id="s4_13" value="&lt;b&gt;Attach Done + Success Popup&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9.5px'&gt;Record _ppo_attached_paths, unlock UI, show &amp;#x27;Auto-attach to PPO: Done (N subfolder(s))&amp;#x27; &amp;amp; completion popup.&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#15803D;strokeWidth=1.5;fontColor=#1E293B;fontSize=10;" vertex="1" parent="1">
