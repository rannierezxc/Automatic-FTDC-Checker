  <diagram id="slide_3" name="3. Duplicate, QC &amp; FTDC Criteria">
    <mxGraphModel dx="1420" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1360" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="slide_3_title" value="&lt;b&gt;PTS Hub — Detailed Process Flow (3/4): Duplicate Detection Engines, QC Check 4 &amp;amp; FTDC Criteria&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1E3A5F;fontColor=#FFFFFF;strokeColor=none;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="28" y="14" width="1224" height="52" as="geometry" />
        </mxCell>
        <mxCell id="slide_3_lane_1" value="3A. Interning &amp;amp; FIRST PASS Scan" style="swimlane;startSize=34;rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#1D4ED8;strokeColor=#93C5FD;swimlaneFillColor=#EFF6FF;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="28" y="82" width="286" height="614" as="geometry" />
        </mxCell>
        <mxCell id="slide_3_lane_2" value="3B. RETEST State &amp;amp; Multi-ID Engine" style="swimlane;startSize=34;rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#0F766E;strokeColor=#5EEAD4;swimlaneFillColor=#F0FDFA;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="340" y="82" width="286" height="614" as="geometry" />
        </mxCell>
        <mxCell id="slide_3_lane_3" value="3C. QC Check 4 &amp;amp; Quantities" style="swimlane;startSize=34;rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#B45309;strokeColor=#FCD34D;swimlaneFillColor=#FFFBEB;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="652" y="82" width="286" height="614" as="geometry" />
        </mxCell>
        <mxCell id="slide_3_lane_4" value="3D. Criteria Checks &amp;amp; Remarks" style="swimlane;startSize=34;rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#15803D;strokeColor=#86EFAC;swimlaneFillColor=#F0FDF4;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="964" y="82" width="286" height="614" as="geometry" />
        </mxCell>
        <mxCell id="s3_1" value="&lt;b&gt;Intern Valid Identifiers -&amp;gt; C-Arrays&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9.5px'&gt;Valid WXYs mapped to integer ID _wid &amp;gt;= 1; invalid WXYs (NaN, 0_1_2, 0_0_0, 24_0_0) assigned 0 (excluded).&lt;/font&gt;" style="rounded=1;arcSize=26;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D4ED8;strokeWidth=2;fontColor=#1E293B;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="48" y="144" width="247" height="99" as="geometry" />
        </mxCell>
        <mxCell id="s3_2" value="&lt;b&gt;Scan FIRST PASS Rows (_wid &amp;gt;= 1)&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9.5px'&gt;1) Seen in FP (PASS or FAIL)? -&amp;gt; +1 fp_datalog_duplicate_count.&#10;2) Active FP PASS? -&amp;gt; +1 duplicate_guid.&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D4ED8;strokeWidth=1.5;fontColor=#1E293B;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="48" y="270" width="247" height="119" as="geometry" />
        </mxCell>
        <mxCell id="s3_3" value="&lt;b&gt;FP Row == PASS?&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9.5px'&gt;(PART_FLG &amp;amp; 0x08 == 0)&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#D97706;strokeWidth=2;fontColor=#9A3412;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="46" y="416" width="251" height="88" as="geometry" />
        </mxCell>
        <mxCell id="s3_4" value="&lt;b&gt;Update State &amp;amp; FP Reject Check&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9.5px'&gt;PASS: add to fp_pass_ids &amp;amp; wxy_head_pass_ids.&#10;FAIL: discard head pass; if HARD_BIN != 3 &amp;amp; _wid not in retest_all_ids -&amp;gt; +1 fp_rejects_not_in_retest (NO).&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D4ED8;strokeWidth=1.5;fontColor=#1E293B;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="48" y="531" width="247" height="134" as="geometry" />
        </mxCell>
        <mxCell id="s3_5" value="&lt;b&gt;Scan RETEST Rows (_wid &amp;gt;= 1)&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9.5px'&gt;Priority 1 (retest_pass_seen_ids): prior RETEST was PASS -&amp;gt; +1 retest_duplicate_guid (RETEST Duplicate; promote source).&#10;Priority 2: active FP PASS -&amp;gt; +1 duplicate_guid.&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=1.5;fontColor=#1E293B;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="360" y="144" width="247" height="113" as="geometry" />
        </mxCell>
        <mxCell id="s3_6" value="&lt;b&gt;Update RETEST Active Sets&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9.5px'&gt;PASS -&amp;gt; add to wxy_head_pass_ids &amp;amp; retest_pass_seen_ids.&#10;FAIL -&amp;gt; discard from both (allows recovery retest without false duplicate).&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=1.5;fontColor=#1E293B;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="360" y="282" width="247" height="107" as="geometry" />
        </mxCell>
        <mxCell id="s3_7" value="&lt;b&gt;Multi-ID Mode?&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9.5px'&gt;(SG406 / UID+BT+ZB)&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#D97706;strokeWidth=2;fontColor=#9A3412;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="358" y="416" width="251" height="86" as="geometry" />
        </mxCell>
        <mxCell id="s3_8" value="&lt;b&gt;Multi-ID MACID &amp;amp; Unique Checks&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9.5px'&gt;Map valid BT/ZB MACIDs -&amp;gt; UIDs across ALL panels (PASS &amp;amp; FAIL); flag &amp;gt;1 UID.&#10;Run Good Unique Cross-Check (WXY vs UID vs BT vs ZB) for diffs &amp;amp; &amp;gt;1 maps.&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.5;fontColor=#1E293B;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="360" y="528" width="247" height="142" as="geometry" />
        </mxCell>
        <mxCell id="s3_9" value="&lt;b&gt;Build Total Good Set &amp;amp; QC Scan&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9.5px'&gt;total_good_ids = fp_pass_ids | retest_pass_ids.&#10;Extract valid QC _wid (&amp;gt;0); count duplicates within QC as qc_duplicate_guid.&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B45309;strokeWidth=1.5;fontColor=#1E293B;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="672" y="144" width="247" height="101" as="geometry" />
        </mxCell>
        <mxCell id="s3_10" value="&lt;b&gt;QC Check 4 Set Comparison&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9.5px'&gt;Good in prev op = |qc_unique &amp;amp; total_good_ids|.&#10;Failed/Missing prev op = |qc_unique - total_good_ids| (tagged for RED Excel highlighting).&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B45309;strokeWidth=1.5;fontColor=#1E293B;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="672" y="272" width="247" height="119" as="geometry" />
        </mxCell>
        <mxCell id="s3_11" value="&lt;b&gt;Compute FP &amp;amp; Total Good Deltas&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9.5px'&gt;Calc_FP_Good = FP_PASS - duplicate_guid&#10;Delta_FP = Calc_FP_Good - FP_Actual_Good&#10;Calc_Total = (FP_PASS + RT_PASS) - Total_Dup_GUID&#10;Delta_Total = Calc_Total - Total_Actual&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B45309;strokeWidth=1.5;fontColor=#1E293B;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="672" y="418" width="247" height="120" as="geometry" />
        </mxCell>
        <mxCell id="s3_12" value="&lt;b&gt;Apply Diff Highlight Metadata&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9.5px'&gt;Diff == 0 -&amp;gt; Bold Green; Diff &amp;gt; 0 (surplus) -&amp;gt; Pass w/ Red attention highlight; Diff &amp;lt; 0 -&amp;gt; FAIL (Red).&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B45309;strokeWidth=1.5;fontColor=#1E293B;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="672" y="566" width="247" height="99" as="geometry" />
        </mxCell>
        <mxCell id="s3_13" value="&lt;b&gt;Evaluate Check 1, Check 2 &amp;amp; Check 4&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9.5px'&gt;Check 1: Delta_Total &amp;gt;= 0 &amp;amp; FP Datalog Dup == 0 (+ Multi-ID dups/discrepancies == 0).&#10;Check 2: Total_Dup_GUID &amp;lt;= 72.&#10;Check 4: qc_failed_prev_op == 0.&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#15803D;strokeWidth=1.5;fontColor=#1E293B;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="984" y="144" width="247" height="124" as="geometry" />
        </mxCell>
        <mxCell id="s3_14" value="&lt;b&gt;First Pass &amp;amp; Total Good Status&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9.5px'&gt;PASS iff Delta &amp;gt;= 0 &amp;amp; Check 4 == PASS &amp;amp; FP_Dup == 0 (+ 0 MACID/Unique fails).&#10;If Multi-ID &amp;amp; Total_Actual == 0 (0 MACID dups) -&amp;gt; SKIPPED.&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#15803D;strokeWidth=1.5;fontColor=#1E293B;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="984" y="295" width="247" height="117" as="geometry" />
        </mxCell>
        <mxCell id="s3_15" value="&lt;b&gt;Multi-Violation Remarks Engine&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9.5px'&gt;Concatenate ALL active violations: QC Check 4 fails, FP Dup WXY, Dup BT/ZB MACID, Good Unique mismatch; else status fallback.&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#15803D;strokeWidth=1.5;fontColor=#1E293B;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="984" y="439" width="247" height="122" as="geometry" />
        </mxCell>
        <mxCell id="s3_16" value="&lt;b&gt;Build Result Dict -&amp;gt; Slide 4&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9.5px'&gt;Bundle panel rows, counts, labels, criteria &amp;amp; remarks -&amp;gt; _deliver_analysis_result.&lt;/font&gt;" style="rounded=1;arcSize=26;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#15803D;strokeWidth=2;fontColor=#1E293B;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="984" y="587" width="247" height="82" as="geometry" />
        </mxCell>
