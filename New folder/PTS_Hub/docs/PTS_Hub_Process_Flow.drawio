        <mxCell id="s4_14" value="&lt;b&gt;PPO Fail/Partial Fallback&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9.5px'&gt;After 3 retries failed: copy .xlsx &amp;amp; .png to C:\FTDC\&amp;lt;Lot&amp;gt; fallback &amp;amp; notify user w/ Open Local Folder option.&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.5;fontColor=#1E293B;fontSize=10;" vertex="1" parent="1">
