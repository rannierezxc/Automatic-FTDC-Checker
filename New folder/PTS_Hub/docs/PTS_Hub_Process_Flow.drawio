        <mxCell id="s4_15" value="&lt;b&gt;Utilities: Help &amp;amp; Clear All&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:9.5px'&gt;Help button opens PPT from settings[&amp;#x27;help_dir&amp;#x27;]; Clear All increments generation IDs, cancels pending Stage 1/2 &amp;amp; resets UI.&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#15803D;strokeWidth=1.5;fontColor=#1E293B;fontSize=10;" vertex="1" parent="1">
